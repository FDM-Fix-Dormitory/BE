{
  "name": "fdm",
  "version": "0.1.0",
  "description": "D.O.M TypeScript Express MySQL backend",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "db:migrate": "tsx src/migrate.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/*.integration.ts",
    "db:seed": "tsx src/seed.ts",
    "user:create": "tsx src/create-user.ts"
  },
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "license": "MIT",
  "main": "dist/server.js"
}
